programa { 
  funcao inicio() { 
    //vetor é um conjunto de variáveis do mesmo tipo.
    inteiro vetor [10]
    vetor[3]=2 //coloquei o valor 2 na posição 3
    escreva(vetor[3]) //mostra na tela 2
    vetor[3]=vetor[3]-3// pra somar, subtrair, multiplicar e dividir vetor (so muda sinal)
    escreva("\n",vetor[3])
    }
    
  }
}
