programa {
  funcao inicio() {
    //Podemos inicializar o valor de um vetor dentro de um laço de repetição.
    //EX: PREENCHER O VETOR COM VALORES 1.
    inteiro vetor [5] //tem que atribuir valor primeiro 
    para(inteiro posicao=0;posicao<5;posicao++){ 
      vetor[posicao]=1
      escreva(vetor[posicao]) // se ficar fora do laço, ele n aceita a variável 
    }
  }
}
